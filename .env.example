APP_ENV=development

# Docker Compose publishes frontend, backend, and database ports on 127.0.0.1 only.
# Change the Compose bindings deliberately if a different network posture is required.
FRONTEND_PORT=3000
BACKEND_PORT=8000
DATABASE_PORT=5432

POSTGRES_DB=jailbreaker
POSTGRES_USER=jailbreaker
POSTGRES_PASSWORD=jailbreaker

DATABASE_URL=postgresql://jailbreaker:jailbreaker@database:5432/jailbreaker
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Live target fallback configuration (for mode=live).
# For repeated local use, prefer encrypted UI-managed LLM profiles instead
# of putting provider keys in .env files.
TARGET_API_KEY=
TARGET_API_BASE_URL=https://api.openai.com/v1
TARGET_MODEL=gpt-4o-mini
